{
  "name": "chess-game",
  "version": "1.0.0",
  "description": "Chess game implementation using boardgame.io framework",
  "scripts": {
    "start": "parcel public/index.html --port 3001",
    "build": "parcel build public/index.html --dist-dir dist",
    "test": "jest",
    "dev": "parcel public/index.html --port 3000 --open"
  },
  "keywords": [
    "chess",
    "boardgame.io",
    "react",
    "game"
  ],
  "author": "Chess Game Developer",
  "license": "MIT",
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "parcel": "^2.10.0",
    "process": "^0.11.10"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    },
    "transform": {
      "^.+\\.(js|jsx)$": [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
